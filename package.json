{
  "name": "@quill507/dsh-auto-approval-llm",
  "version": "0.0.9",
  "description": "LLM-assisted auto approval with timeout fallback for DeepSeek Harness",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuddly-guacamole/dsh-auto-approval-llm.git"
  },
  "bugs": {
    "url": "https://github.com/cuddly-guacamole/dsh-auto-approval-llm/issues"
  },
  "homepage": "https://github.com/cuddly-guacamole/dsh-auto-approval-llm#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.0 <2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0 <2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "mermaid": "^11.0.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "author": "quill507"
}
